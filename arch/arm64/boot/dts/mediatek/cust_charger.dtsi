/* mtk charge */
&pe5 {
	vbat-cv = <4480>;
	gauge = <&mtk_gauge>;
	allow_not_check_ta_status;

	idvchg-term = <800>;
	ita-level-dual = <6000 5700 4400 3000>;
	rcable-level-dual = <230 350 450 550>;
};

&lk_charger {
	/* charging current */
	usb-charger-current = <500000>;
	ac-charger-current = <500000>;
	ac_charger_input_current = <2050000>;
	charging-host-charger-current = <500000>;
};

&charger {
	battery_cv = <4450000>;
	charger-configuration = <2>;

	ac-charger-current = <3200000>;
	ac-charger-input-current = <3000000>;

	max_pwr = <30>;
	fast_charging_indicator = <16>; // PE50

	/* step charging */
	cs,chrg-temp-zones-num = <4>;
	cs,chrg-temp-zones = <0 4450 0 0 0 0 0>,
                                <10 4450 1200 0 0 0 0>,
                                <45 4200 7500 4350 6000 4450 4200>,
                                <55 4100 3000 0 0 0 0>;
        /* thermal ibus step */
	cs,chrg-thermal-zones = <0 0 3000>,
				<38 36 2500>,
				<40 38 2200>,
				<43 40 2000>,
				<45 43 1400>;
	cs,chrg-wireless-thermal-zones = <0 0 2050>,
				<36 34 1500>,
				<38 36 1000>,
				<43 41 800>,
				<45 43 600>;
	/* ffc charging */
	cs,chrg-ffc-zones = <0 4450 120>,
                         <15 4450 120>,
                         <25 4480 600>,
                         <35 4480 600>,
                         <40 4480 600>,
                         <45 4480 600>,
                         <55 4100 120>;
	/* battery temperature protection */
        enable_min_charge_temp;
        min_charge_temp = <0>;
        min_charge_temp_plus_x_degree = <3>;
        max_charge_temp = <55>;
        max_charge_temp_minus_x_degree = <50>;
};

&mtk_gauge {
        battery = <&sh366100>;
	disable-mtkbattery;

};
/*
&mt6375_chg{
	mt,otg_en_gpio = <&pio 110 0x0>;

};
*/
&i2c3 {
	status = "okay";
	clock-frequency = <400000>;

	wireless_chg_rx@2b {
		compatible = "maxictech,mt5706";
		reg = <0x2b>;
		irq_gpio = <&pio 12 0>;	//EINT_WPC
		tx_en_gpio = <&pio 111 0>;	//tx_en
		chipen_gpio = <&pio 112 0>;	//CHARGE_EN
		pg_irq_gpio = <&pio 113 0>;
		otg_en_gpio = <&pio 110 0>; // OTG EN
/*
		pinctrl-names = "default", "charger_otg_off", "charger_otg_on",
				 "wireless_5728_off", "wireless_5728_on","charger_otg_mode_on","charger_otg_mode_off";
		pinctrl-0 = <&charger_otg_pins_default>;
		pinctrl-1 = <&charger_otg_off>;//WPC_OTG_EN
		pinctrl-2 = <&charger_otg_on>;//WPC_OTG_EN
		pinctrl-3 = <&wireless_5728_off>;//WPC_OTG_EN2
		pinctrl-4 = <&wireless_5728_on>;//WPC_OTG_EN2
		pinctrl-5 = <&charger_otg_mode_on>;//WPC_OTG_mode_on
		pinctrl-6 = <&charger_otg_mode_off>;//WPC_OTG_mode_off
*/
	};
};
